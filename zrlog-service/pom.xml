<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>zrlog-base</artifactId>
        <groupId>com.hibegin</groupId>
        <version>4.0.1</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>zrlog-service</artifactId>
    <name>ZrLog Service</name>

    <dependencies>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger</artifactId>
            <version>${dagger.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hibegin</groupId>
            <artifactId>zrlog-test-support</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.hibegin</groupId>
            <artifactId>zrlog-data</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.dagger</groupId>
                            <artifactId>dagger-compiler</artifactId>
                            <version>${dagger.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <!-- TODO cover runtime/process, plugin-core transport, static-site generation/cache,
                             and online-upgrade network boundaries with slower integration tests. -->
                        <exclude>com/zrlog/business/plugin/BodySaveResponse.class</exclude>
                        <exclude>com/zrlog/business/plugin/PluginConsole.class</exclude>
                        <exclude>com/zrlog/business/plugin/PluginCorePluginImpl*.class</exclude>
                        <exclude>com/zrlog/business/plugin/PluginCoreProcessImpl*.class</exclude>
                        <exclude>com/zrlog/business/plugin/StaticSitePlugin.class</exclude>
                        <exclude>com/zrlog/business/service/UpgradeService.class</exclude>
                        <exclude>com/zrlog/business/updater/UpdateVersionInfoPlugin.class</exclude>
                        <exclude>com/zrlog/business/util/CacheUtils.class</exclude>
                        <exclude>com/zrlog/business/util/CmdUtil.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
